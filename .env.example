# Copy to .env and fill in values from your Azure Foundry project.
# All values are endpoints/names — NO secrets. Auth is via `az login` (DefaultAzureCredential).
#
# ONE Foundry resource serves everything. Three URL formats, same resource:
#   https://<resource>.services.ai.azure.com       ← Foundry SDK / agent / project ops
#   https://<resource>.openai.azure.com            ← OpenAI Python SDK (Chat Completions, Responses)
#   https://<resource>.cognitiveservices.azure.com ← Language / Speech / Content Safety / CU SDKs
# Find all on: Azure portal → your Foundry resource → Keys and Endpoint

# --- Microsoft Foundry ---
FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project-name>
DEFAULT_MODEL=gpt-4.1-mini
REASONING_MODEL=o4-mini
IMAGE_MODEL=gpt-image-1
VIDEO_MODEL=sora
EMBEDDING_MODEL=text-embedding-3-large
MODEL_ROUTER_DEPLOYMENT=model-router

# --- Azure AI Language (Foundry Tool — same resource, cognitiveservices subdomain) ---
LANGUAGE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
LANGUAGE_MCP_URL=https://<resource>.cognitiveservices.azure.com/language/mcp?api-version=2025-11-15-preview

# --- Azure AI Translator (Foundry Tool — use services.ai.azure.com subdomain) ---
TRANSLATOR_ENDPOINT=https://<resource>.services.ai.azure.com
TRANSLATOR_API_VERSION=2025-10-01-preview

# --- Azure AI Speech (Foundry Tool — same resource, cognitiveservices subdomain) ---
# SPEECH_REGION is only needed for batch transcription REST + LLM speech preview URLs.
# speech_config() (SpeechRecognizer / SpeechSynthesizer) uses SPEECH_ENDPOINT directly.
SPEECH_REGION=eastus
SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com
SPEECH_MCP_URL=https://<resource>.cognitiveservices.azure.com/speech/mcp?api-version=2025-11-15-preview
VOICE_LIVE_ENDPOINT=wss://<resource>.services.ai.azure.com/voice-live/v1
# Custom Speech: deploy a custom model in Speech Studio → copy the endpoint ID (GUID)
CUSTOM_SPEECH_ENDPOINT_ID=

# --- Azure Content Understanding (Foundry Tool — use services.ai.azure.com subdomain) ---
CU_ENDPOINT=https://<resource>.services.ai.azure.com
CU_API_VERSION=2025-11-15-preview

# --- Azure AI Content Safety (Foundry Tool — same resource, cognitiveservices subdomain) ---
CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com

# --- Azure AI Search (separate resource — create in Azure portal) ---
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_INDEX=northwind-docs
SEARCH_INDEX_VECTOR=northwind-docs-vector
SEARCH_INDEXER=northwind-indexer
SEARCH_SKILLSET=northwind-skillset

# --- Azure Blob Storage (separate resource — for RAG ingestion + batch STT) ---
STORAGE_ACCOUNT=<storage-account-name>
STORAGE_CONTAINER=northwind-docs
STORAGE_CONNECTION_STRING=

# --- Observability (Azure Monitor — optional, tracing lands in Application Insights) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- RBAC / role assignments (used by 01-plan-and-manage/13_rbac_role_policies.py) ---
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>

# --- Domain 2 — OpenAPI agent backend (used by 02-generative-ai-and-agents/12_agent_openapi_tools.py) ---
# The Azure Function in `02-generative-ai-and-agents/azure_functions_orders/` hosts
# the Northwind Orders REST API. Set this to the URL WITHOUT the /api suffix.
# Local:    ORDERS_FN_ENDPOINT=http://localhost:7071   (after `func start`)
# Deployed: ORDERS_FN_ENDPOINT=https://fn-northwind-<yours>.azurewebsites.net
ORDERS_FN_ENDPOINT=
