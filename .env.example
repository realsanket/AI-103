# Copy to .env and fill in values from your Azure Foundry project.
# All values are endpoints/names — NO secrets. Auth is via `az login` (DefaultAzureCredential).

# --- Microsoft Foundry ---
FOUNDRY_ENDPOINT=https://<foundry-resource>.services.ai.azure.com
PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
DEFAULT_MODEL=gpt-4.1-mini
REASONING_MODEL=o4-mini
IMAGE_MODEL=gpt-image-1
VIDEO_MODEL=sora
EMBEDDING_MODEL=text-embedding-3-large
MODEL_ROUTER_DEPLOYMENT=model-router

# --- Azure AI Search ---
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_INDEX=cloudxeus-docs
SEARCH_INDEX_VECTOR=cloudxeus-docs-vector
SEARCH_INDEXER=cloudxeus-indexer
SEARCH_SKILLSET=cloudxeus-skillset

# --- Azure AI Language ---
LANGUAGE_ENDPOINT=https://<language-resource>.cognitiveservices.azure.com
LANGUAGE_MCP_URL=https://<foundry-resource>.cognitiveservices.azure.com/language/mcp?api-version=2025-11-15-preview

# --- Azure Translator (via Foundry Tools) ---
TRANSLATOR_ENDPOINT=https://<foundry-resource>.services.ai.azure.com
TRANSLATOR_API_VERSION=2025-10-01-preview

# --- Azure AI Speech ---
SPEECH_REGION=eastus
SPEECH_ENDPOINT=https://<speech-resource>.cognitiveservices.azure.com
SPEECH_MCP_URL=https://<foundry-resource>.cognitiveservices.azure.com/speech/mcp?api-version=2025-11-15-preview
VOICE_LIVE_ENDPOINT=wss://<foundry-resource>.services.ai.azure.com/voice-live/v1

# --- Azure Content Understanding ---
CU_ENDPOINT=https://<foundry-resource>.services.ai.azure.com
CU_API_VERSION=2025-11-15-preview

# --- Azure Blob Storage (for RAG ingestion + batch STT) ---
STORAGE_ACCOUNT=<storage-account-name>
STORAGE_CONTAINER=cloudxeus-docs
STORAGE_CONNECTION_STRING=

# --- Observability (OpenTelemetry → Azure Monitor) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Content Safety / Guardrails ---
CONTENT_SAFETY_ENDPOINT=https://<content-safety-resource>.cognitiveservices.azure.com
