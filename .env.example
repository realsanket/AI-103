# Copy to .env and fill in values from your Azure Foundry project.
# All values are endpoints/names — NO secrets. Auth is via `az login` (DefaultAzureCredential).
#
# ONE Foundry resource serves everything. Three URL formats, same resource:
#   https://<resource>.services.ai.azure.com       ← Foundry SDK / agent / project ops
#   https://<resource>.openai.azure.com            ← OpenAI Python SDK (Chat Completions, Responses)
#   https://<resource>.cognitiveservices.azure.com ← Language / Speech / Content Safety / CU SDKs
# Find all on: Azure portal → your Foundry resource → Keys and Endpoint

# --- Microsoft Foundry ---
FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project-name>
# Model values are DEPLOYMENT names. Suggested models and their lifecycle
# (Foundry model retirement schedule, September 2026):
#   gpt-4.1-mini   deprecated, retires 2027-04-14; kept because temperature
#                  lessons need a non-reasoning chat model
#   gpt-5.6-terra  GA reasoning model; replaces o4-mini (retires 2026-11-19)
#   gpt-image-2    GA; replaces gpt-image-1 (preview, retires 2026-10-23); DALL-E 3 is retired
#   sora-2         preview (2025-12-08 version retires 2026-10-15); the original sora is retired
DEFAULT_MODEL=gpt-4.1-mini
REASONING_MODEL=gpt-5.6-terra
IMAGE_MODEL=gpt-image-2
VIDEO_MODEL=sora-2
EMBEDDING_MODEL=text-embedding-3-large
MODEL_ROUTER_DEPLOYMENT=model-router
# Domain 1 lesson 03 only: model family/version to deploy and its new deployment alias.
# DEFAULT_MODEL remains an already deployed alias used by inference lessons.
DEPLOYMENT_NAME=
DEPLOYMENT_MODEL_NAME=
DEPLOYMENT_MODEL_VERSION=

# --- Azure AI Language (Foundry Tool — same resource, cognitiveservices subdomain) ---
LANGUAGE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
LANGUAGE_MCP_URL=https://<resource>.cognitiveservices.azure.com/language/mcp?api-version=2025-11-15-preview

# --- Azure AI Translator ---
# _shared.translator_client uses the direct global endpoint and API version 3.0
# with keyless Microsoft Entra authentication. This ARM resource ID is an
# identifier, not a secret; it is required as Ocp-Apim-ResourceId.
TRANSLATOR_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<translator-resource-name>
# D4 L23 Document Translation deliberately reads TRANSLATOR_DOCUMENT_KEY only
# from runtime environment or a secret store. Do not add that key here.

# --- Azure AI Speech (Foundry Tool — same resource, cognitiveservices subdomain) ---
# SPEECH_REGION is only needed for batch transcription REST + LLM speech preview URLs.
# speech_config() (SpeechRecognizer / SpeechSynthesizer) uses SPEECH_ENDPOINT directly.
SPEECH_REGION=eastus
SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com
SPEECH_MCP_URL=https://<resource>.cognitiveservices.azure.com/speech/mcp?api-version=2025-11-15-preview
VOICE_LIVE_ENDPOINT=wss://<resource>.services.ai.azure.com/voice-live/realtime
# Custom Speech: deploy a custom model in Speech Studio → copy the endpoint ID (GUID)
CUSTOM_SPEECH_ENDPOINT_ID=
# D4 L13 BATCH_STT_CONTAINER_SAS is a runtime-only Blob container SAS bearer
# secret. Supply it through your shell, Key Vault, or CI secret store; never
# add it to this template or source.

# --- Azure Content Understanding (Foundry Tool — use services.ai.azure.com subdomain) ---
CU_ENDPOINT=https://<resource>.services.ai.azure.com
CU_API_VERSION=2025-11-01

# --- Azure Document Intelligence v4.0 GA (Domain 9) ---
# Microsoft Entra authentication requires this custom subdomain endpoint.
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# Custom neural IDs and prefixes are non-secret. Keep source and training-container
# URLs out of this file because Blob SAS query strings are secrets.
DI_CUSTOM_NEURAL_MODEL_ID=
DI_CUSTOM_NEURAL_PREFIX=

# --- Azure AI Content Safety (Foundry Tool — same resource, cognitiveservices subdomain) ---
CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# Domain 1 lesson 20: HTTPS Blob URL or SAS URL for media provenance detection.
PROVENANCE_SOURCE_URL=

# --- Azure AI Search (separate resource — create in Azure portal) ---
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_INDEX=northwind-docs
SEARCH_INDEX_VECTOR=northwind-docs-vector
SEARCH_INDEXER=northwind-indexer
SEARCH_SKILLSET=northwind-skillset
# Domain 2 lesson 27 and Domain 5 lesson 20: existing Foundry project connection for this Search service.
SEARCH_CONNECTION_NAME=
# Domain 5 lesson 17: reachable HTTPS WebApiSkill endpoint. Do not use localhost,
# function keys, or bearer tokens here; keep runtime credentials in a secret store.
CUSTOM_SKILL_URL=

# --- Azure Blob Storage (separate resource — for RAG ingestion + batch STT) ---
STORAGE_ACCOUNT=<storage-account-name>
STORAGE_CONTAINER=northwind-docs
# Domain 3 lessons 13, 14, and 17: service-reachable image/video sources for CU.
# Use a short-lived, read-only HTTPS Blob SAS; do not commit source URLs.
SAMPLE_IMAGE_URL=
SAMPLE_VIDEO_URL=

# --- Observability (Azure Monitor — optional, tracing lands in Application Insights) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Domain 1 evaluation labs (22, 32-34) and Domain 2 cloud evaluation (22) ---
# AZURE_AI_PROJECT_ENDPOINT is normally the same value as PROJECT_ENDPOINT.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_AGENT_NAME=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# --- Management plane: deployment (D1 lesson 03), RBAC (D1 lesson 08), Search identity data sources ---
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>

# --- Domain 2 — OpenAPI agent backend (used by 02-generative-ai-and-agents/12_agent_openapi_tools.py) ---
# The Azure Function in `02-generative-ai-and-agents/azure_functions_orders/` hosts
# the Northwind Orders REST API. Set this to the URL WITHOUT the /api suffix.
# Local:    ORDERS_FN_ENDPOINT=http://localhost:7071   (after `func start`)
# Deployed: ORDERS_FN_ENDPOINT=https://fn-northwind-<yours>.azurewebsites.net
ORDERS_FN_ENDPOINT=

# --- Domain 2 — MCP tool preflight (lesson 25) ---
# Deploy northwind_mcp separately, create matching Foundry project connection,
# then use reachable HTTPS endpoint. Do not put keys or tokens in this file.
NORTHWIND_MCP_ENDPOINT=
NORTHWIND_MCP_CONNECTION=

# --- Domains 2 and 8 — Toolbox / advanced-agent identifiers (no secrets) ---
# Domain 2 lesson 26 defaults to northwind-tool-catalog-lab when this is blank.
# Pass the immutable version to lesson 26 with --toolbox-version.
# Foundry IQ connection uses project-managed identity, not Search keys.
FOUNDRY_IQ_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
FOUNDRY_IQ_KNOWLEDGE_BASE=
FOUNDRY_IQ_CONNECTION_NAME=
FOUNDRY_TOOLBOX_NAME=
FOUNDRY_AGENT_NAME=
FOUNDRY_SKILL_NAME=
# Azure API Center resource ID is an identifier, not a credential.
API_CENTER_RESOURCE_ID=
BING_PROJECT_CONNECTION_ID=
BING_CUSTOM_SEARCH_INSTANCE=
FABRIC_IQ_CONNECTION_ID=
WORK_IQ_CONNECTION_ID=
FABRIC_DATA_AGENT_CONNECTION_ID=
SHAREPOINT_CONNECTION_ID=
BROWSER_PROJECT_CONNECTION_ID=
COMPUTER_USE_MODEL=computer-use-preview

# --- Lesson-specific identifiers (optional; all non-secret) -----------------
# Blank means "use the lesson default" or "not configured". Deployment values
# are DEPLOYMENT names in your Foundry resource.

# Domain 1: evaluation, guardrail, and CI/CD labs
AZURE_AI_AGENT_VERSION=
GUARDRAIL_MODEL=
PII_GUARDRAIL_MODEL=
EVAL_TARGET_TYPE=
EVAL_TARGET_NAME=
EVAL_DATASET_PATH=
EVAL_ID=
EVAL_RUN_ID=
SYNTHETIC_TASK=
SYNTHETIC_INPUT_PATH=
SYNTHETIC_OUTPUT_NAME=
SYNTHETIC_MAX_SAMPLES=

# Domain 2: OpenAPI key connection (lesson 12), webhooks (39), A2A (40-41),
# external agents (42), hosted-agent guardrails and sessions (48-49)
ORDERS_CONNECTION_NAME=
WEBHOOK_NAME=
# HTTPS receiver endpoint only; never put a token in the URL.
WEBHOOK_URL=
A2A_AUTH_MODE=
A2A_CONNECTION_NAME=
A2A_TARGET_AGENT_URL=
A2A_ENTRA_AUDIENCE=
A2A_KEY_NAME=
A2A_OAUTH_CLIENT_ID=
A2A_OAUTH_AUTHORIZATION_URL=
A2A_OAUTH_TOKEN_URL=
A2A_OAUTH_REFRESH_URL=
A2A_OAUTH_SCOPES=
FOUNDRY_ACCOUNT_NAME=
FOUNDRY_PROJECT_NAME=
EXTERNAL_AGENT_NAME=
EXTERNAL_AGENT_DESCRIPTION=
EXTERNAL_AGENT_ENDPOINT=
EXTERNAL_AGENT_OTEL_ID=
HOSTED_AGENT_NAME=
HOSTED_AGENT_IMAGE=
HOSTED_SESSION_ID=
# Full ARM ID: /subscriptions/.../accounts/<account>/raiPolicies/<guardrail>
RAI_POLICY_ID=

# Domain 4: audio and live-voice deployments (lesson defaults apply when blank)
AUDIO_MODEL=
REALTIME_MODEL=
GPT_LIVE_MODEL=
GPT_LIVE_RESPONSES_MODEL=

# Domain 5: agentic-retrieval knowledge sources and knowledge base (21-27)
# Use the keyless ResourceId=/subscriptions/... form, never an account-key
# connection string.
SEARCH_BLOB_CONNECTION=
SEARCH_BLOB_CONTAINER=
SEARCH_KNOWLEDGE_BASE=
SEARCH_KS_BLOB=
SEARCH_KS_INDEX=
SEARCH_KS_WEB=
SEARCH_WEB_ALLOWED_DOMAIN=
SEARCH_WEB_BLOCKED_DOMAIN=
SEARCH_RETRIEVE_QUESTION=
# Lesson 28 SharePoint indexer ACL preflight (site URL is an identifier, not a secret)
SHAREPOINT_SITE_URL=

# Domain 6: partner-model deployments (lessons 15 and 17)
CLAUDE_DEPLOYMENT=
DEEPSEEK_MODEL=

# Domain 7: account used by the PTU spillover preflight (lesson 10)
AZURE_COGNITIVE_ACCOUNT=

# Domain 8: MCP servers (lessons 09, 10, 18), Agent 365 (13), and Functions queue tool (19)
MCP_SERVER_URL=
MCP_CONNECTION_NAME=
MCP_CONNECTION_ID=
MCP_TOOL_NAME=
STORAGE_QUEUE_ENDPOINT=
AGENT_365_CLIENT_ID=

# Domain 9: custom neural build limit and Healthcare AI endpoint
DI_CUSTOM_NEURAL_MAX_TRAINING_HOURS=
HEALTHCARE_AI_ENDPOINT=

# --- Runtime-only values: NEVER set these in this file ----------------------
# Supply through your shell, Key Vault, or a CI secret store:
#   Blob SAS / document URLs: CU_READ_SOURCE_URL, CU_LAYOUT_SOURCE_URL,
#     SAMPLE_INVOICE_URL, CU_SUPPORT_NOTICE_URL, CU_PACKAGE_SOURCE_URLS,
#     CU_MARKDOWN_SOURCE_URL, DI_*_SOURCE_URL, DI_TRAINING_CONTAINER_URL,
#     BATCH_STT_CONTAINER_SAS
#   Keys and secrets: AZURE_OPENAI_API_KEY, TRANSLATOR_DOCUMENT_KEY,
#     A2A_KEY_VALUE, A2A_OAUTH_CLIENT_SECRET, HEALTHCARE_AI_KEY,
#     OPENAI_WEBHOOK_SECRET
