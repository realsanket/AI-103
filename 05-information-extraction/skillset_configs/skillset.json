{
  "name": "${SEARCH_SKILLSET}",
  "description": "Split Blob document text into chunks and create Azure OpenAI embeddings.",
  "skills": [
    {
      "@odata.type": "#Microsoft.Skills.Text.SplitSkill",
      "name": "split-document",
      "description": "Split extracted text into overlapping RAG chunks.",
      "context": "/document",
      "defaultLanguageCode": "en",
      "textSplitMode": "pages",
      "maximumPageLength": 2000,
      "pageOverlapLength": 500,
      "unit": "characters",
      "inputs": [
        {
          "name": "text",
          "source": "/document/content"
        }
      ],
      "outputs": [
        {
          "name": "textItems",
          "targetName": "pages"
        }
      ]
    },
    {
      "@odata.type": "#Microsoft.Skills.Text.AzureOpenAIEmbeddingSkill",
      "name": "embed-chunk",
      "description": "Create an embedding for every chunk.",
      "context": "/document/pages/*",
      "resourceUri": "${AZURE_OPENAI_ENDPOINT}",
      "deploymentId": "${EMBEDDING_MODEL}",
      "modelName": "${EMBEDDING_MODEL}",
      "dimensions": 3072,
      "authIdentity": null,
      "inputs": [
        {
          "name": "text",
          "source": "/document/pages/*"
        }
      ],
      "outputs": [
        {
          "name": "embedding",
          "targetName": "text_vector"
        }
      ]
    }
  ],
  "indexProjections": {
    "selectors": [
      {
        "targetIndexName": "${SEARCH_INDEX_VECTOR}",
        "parentKeyFieldName": "parent_id",
        "sourceContext": "/document/pages/*",
        "mappings": [
          {
            "name": "chunk",
            "source": "/document/pages/*"
          },
          {
            "name": "text_vector",
            "source": "/document/pages/*/text_vector"
          },
          {
            "name": "title",
            "source": "/document/metadata_storage_name"
          },
          {
            "name": "source_url",
            "source": "/document/metadata_storage_path"
          }
        ]
      }
    ],
    "parameters": {
      "projectionMode": "skipIndexingParentDocuments"
    }
  }
}
